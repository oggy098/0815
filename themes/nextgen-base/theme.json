{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "76rem"
		},
		"color": {
			"background": true,
			"custom": true,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#1a2332",
					"name": "Primär"
				},
				{
					"slug": "accent",
					"color": "#8a3e1c",
					"name": "Akzent"
				},
				{
					"slug": "background",
					"color": "#f7f6f3",
					"name": "Hintergrund"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Fläche"
				},
				{
					"slug": "text",
					"color": "#1a2332",
					"name": "Text"
				},
				{
					"slug": "muted",
					"color": "#3e4a59",
					"name": "Gedämpft"
				},
				{
					"slug": "border",
					"color": "#e3dfd6",
					"name": "Linie"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"defaultFontSizes": false,
			"defaultFontFamilies": false,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", \"Liberation Sans\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Klein",
					"size": "0.875rem",
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "medium",
					"name": "Normal",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "large",
					"name": "Gross",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Sehr gross",
					"size": "2.25rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "3.25rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4.25rem"
					}
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "2XS",
					"size": "clamp(0.25rem, 0.4vw, 0.5rem)"
				},
				{
					"slug": "30",
					"name": "XS",
					"size": "clamp(0.5rem, 0.8vw, 0.75rem)"
				},
				{
					"slug": "40",
					"name": "S",
					"size": "clamp(0.75rem, 1.2vw, 1.25rem)"
				},
				{
					"slug": "50",
					"name": "M",
					"size": "clamp(1.25rem, 2vw, 2rem)"
				},
				{
					"slug": "60",
					"name": "L",
					"size": "clamp(2rem, 3.5vw, 3.5rem)"
				},
				{
					"slug": "70",
					"name": "XL",
					"size": "clamp(3rem, 6vw, 5.5rem)"
				},
				{
					"slug": "80",
					"name": "2XL",
					"size": "clamp(4rem, 8vw, 8rem)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"left": "0px",
				"right": "0px"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"bottom": "0.85rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--background)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--background)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"css": ":root{color-scheme:light;} :where(a,button,.wp-element-button,input,textarea,select,summary):focus-visible{outline:2px solid var(--wp--preset--color--accent);outline-offset:3px;} body{text-rendering:optimizeLegibility;}"
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Kopfzeile",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Fusszeile",
			"area": "footer"
		}
	]
}
