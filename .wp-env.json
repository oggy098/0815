{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.3",
  "port": 8888,
  "testsEnvironment": false,
  "themes": [
    "./themes/nextgen-base"
  ],
  "mappings": {
    "wp-content/plugins": "./plugins"
  },
  "lifecycleScripts": {
    "afterStart": "npx --yes @wordpress/env run cli -- wp plugin activate --all"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": true,
    "SCRIPT_DEBUG": true
  }
}
